# =============================================================================
# Server-only (Next.js API routes) — set these in Vercel → Project → Settings.
# These are NEVER shipped to the browser. All data fetching goes through
# API proxy routes (/api/cars, /api/settings, /api/featured).
# =============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...replace.with.anon.key

# Supabase service-role key. Used by /api/cars/[id]/inspection to cache
# inspection data. NEVER expose with NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=eyJ...replace.with.service.role.key

# =============================================================================
# Browser-side — only needed for the admin dashboard (/login, /dashboard).
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...replace.with.anon.key

# =============================================================================
# scraper/post-to-instagram.js — Supabase `cars` row -> Instagram post.
# SUPABASE_URL / SUPABASE_KEY below are the same vars scraper/scraper.js uses.
# =============================================================================

SUPABASE_KEY=eyJ...replace.with.service.role.key

# Long-lived Instagram user access token, via Instagram Login
# (graph.instagram.com) with instagram_business_content_publish.
IG_ACCESS_TOKEN=IGAA...replace.with.ig.access.token
# Instagram Business Account ID — the user id returned alongside the
# access token when it was generated (developers.facebook.com/apps).
IG_BUSINESS_ID=17841...replace.with.ig.business.id

# Optional overrides — defaults match the client's existing caption format.
# IG_POSTS_PER_RUN=5
# IG_CONTACT_PHONE=+37744202673
# IG_SITE_URL=dreshajelitecars.com
# IG_DRY_RUN=true
